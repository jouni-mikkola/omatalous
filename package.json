{
  "name": "banking-app",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @banking/server --filter @banking/web dev",
    "build": "pnpm --filter @banking/web build && pnpm --filter @banking/server build",
    "test": "vitest run --project \"!perf\"",
    "test:perf": "bash tools/test-perf.sh",
    "test:core": "vitest run --project \"!perf\" packages/core",
    "test:server": "vitest run --project \"!perf\" apps/server",
    "test:sh": "for t in tools/test/*.test.sh; do bash \"$t\" || exit 1; done",
    "test:sh:fast": "bash tools/check.sh sh",
    "lint:sh": "bash tools/ci/shell-lint.sh",
    "knip": "knip",
    "check": "pnpm -s knip && node tools/privacy/scan.mjs --local && bash tools/check.sh",
    "coverage": "node tools/coverage.mjs",
    "budgets": "node tools/bundle-budget.mjs",
    "release:prepare": "node tools/release/prepare.mjs",
    "release:fixture": "node tools/release/fixture.mjs",
    "e2e": "node e2e/run.mjs",
    "e2e:years": "E2E_YEARS=1 E2E_WORKERS=1 node e2e/run.mjs --project=years",
    "first-evening": "E2E_FIRST_EVENING=1 E2E_WORKERS=1 node e2e/run.mjs --project=first-evening",
    "where": "node tools/where.mjs",
    "strings": "node tools/ui-strings.mjs",
    "shots": "node tools/shots.mjs",
    "shots:diff": "node tools/shots-diff.mjs",
    "docs:shots": "node tools/docs-shots.mjs",
    "readme:film": "node tools/readme-film/film.mjs",
    "findings": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/findings/cli.ts",
    "tokens": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/tokens/build.ts",
    "typecheck": "pnpm -r typecheck && tsc -p .",
    "seed:demo": "pnpm --filter @banking/server seed:demo",
    "seed:years": "pnpm --filter @banking/server seed:years",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning apps/server/dist/node.js"
  },
  "devDependencies": {
    "@playwright/test": "~1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "happy-dom": "^21.0.4",
    "knip": "6.45.1",
    "typescript": "^7.0.2",
    "typescript6": "npm:typescript@^6.0.3",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@10.28.0"
}
