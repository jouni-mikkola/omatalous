# Omatalous infrastructure settings. scripts/install.sh writes .env for you.
# Everything else (address, time zone, fetch hours, the Enable Banking key) is set in the browser.

# Address the setup wizard suggests. Change it later under Asetukset > Palvelin.
APP_BASE_URL=http://localhost:8080
# true behind Caddy or Cloudflare Tunnel (trust their X-Forwarded-* headers)
TRUST_PROXY=false
# extra services: caddy (Let's Encrypt) or tunnel (Cloudflare); empty for none
COMPOSE_PROFILES=

# This instance (several can run on one machine, one clone directory each). install.sh writes these.
# INSTANCE_NAME names the container, the image (<name>:latest) and the session cookie. Leave it out in an
# install made before it existed: it keeps the name banking-app.
# COMPOSE_PROJECT_NAME prefixes the volumes. Never change either on a running install.
# INSTANCE_NAME=banking-app
# COMPOSE_PROJECT_NAME=banking-app
# HOST_PORT=8080            port on the host
# BIND_ADDRESS=127.0.0.1    host address of that port (a LAN address is plain HTTP)
# CADDY_ADDRESS=            host address for Caddy's ports 80/443, empty = all addresses

# HTTPS options
DOMAIN=
ACME_EMAIL=
CLOUDFLARE_TUNNEL_TOKEN=
# With ~/.config/omatalous/cloudflare.env the installer makes the tunnel and fills the token itself, and writes the
# list of this copy's Access emails here. ./scripts/install.sh --access-emails a@example.fi,b@example.fi changes it.
# CLOUDFLARE_ACCESS_EMAILS=
# The app's own check of Cloudflare Access. With both set, every request must carry the token Access signs for this
# copy, or it gets 403 (GET /api/health excepted). The port on this machine then answers 403 too. The installer fills
# both for a tunnel it made. For a tunnel made by hand copy them from the Zero Trust dashboard: the Access
# application's Application Audience (AUD) Tag, 64 hex characters, and the team domain. Set both or neither.
# CF_ACCESS_AUD=
# CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com

# Optional
# TZ=Europe/Helsinki
# SETUP_CODE=        a fixed one-time code for the first admin (otherwise one is generated)
# INDUSTRY_LOOKUP=false   trade register lookup starts off (Asetukset > Palvelin)

# Running without Docker (pnpm start), the app also reads:
# DATA_DIR=./data
# APP_SECRET_FILE=./secrets/app_secret   created if missing
# SYNC_HOURS=6,18  HISTORY_DAYS=730  SESSION_DAYS=30
# EB_APP_ID=  EB_PRIVATE_KEY_FILE=  EB_REDIRECT_URL=
