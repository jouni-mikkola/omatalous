{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": ["files", "exports", "types"],
  "vitest": false,
  "workspaces": {
    ".": {
      "entry": ["tools/findings/*.ts", "tools/**/*.test.ts", "tools/*.mjs", "tools/lib/{test-setup,test-markup,tmp-guard,dom-environment}.ts", "e2e/**/*.spec.ts", "e2e/*.mjs", "e2e/playwright.config.ts"],
      "project": ["tools/findings/**/*.ts", "tools/lib/*.{ts,mjs}", "e2e/*.ts"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"],
      "includeEntryExports": true
    },
    "apps/server": {
      "entry": ["src/entry/*.ts", "scripts/*.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": true
    },
    "apps/web": {
      "entry": ["src/main.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
      "includeEntryExports": true
    }
  },
  "ignoreIssues": {
    "apps/web/src/design/tokens.ts": ["exports", "types"]
  }
}
