{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": ["files", "exports", "types"],
  "vitest": false,
  "workspaces": {
    ".": {
      "entry": ["tools/findings/*.ts"],
      "project": ["tools/findings/**/*.ts"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"],
      "includeEntryExports": true
    },
    "apps/server": {
      "entry": ["src/entry/*.ts", "scripts/*.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": true
    },
    "apps/web": {
      "entry": ["src/main.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
      "includeEntryExports": true
    }
  },
  "ignoreIssues": {
    "apps/web/src/design/tokens.ts": ["exports", "types"]
  }
}
