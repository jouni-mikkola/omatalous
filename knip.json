{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": ["exports", "types"],
  "vitest": false,
  "workspaces": {
    ".": {
      "entry": ["tools/findings/*.ts"],
      "project": ["tools/findings/**/*.ts"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"],
      "includeEntryExports": true
    },
    "apps/server": {
      "entry": ["src/entry/*.ts", "scripts/*.ts"],
      "project": ["src/**/*.ts"],
      "includeEntryExports": true
    },
    "apps/web": {
      "entry": ["src/main.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
      "includeEntryExports": true
    }
  },
  "ignoreIssues": {
    "apps/web/src/banks.ts": ["exports"],
    "apps/web/src/charts/Axes.tsx": ["exports"],
    "apps/web/src/charts/CalendarHeat.tsx": ["exports"],
    "apps/web/src/charts/PaceChart.tsx": ["exports"],
    "apps/web/src/charts/kit/Annotations.tsx": ["exports"],
    "apps/web/src/charts/kit/Readout.tsx": ["exports"],
    "apps/web/src/charts/kit/ticks.ts": ["exports"],
    "apps/web/src/components/BankLogo.tsx": ["exports"],
    "apps/web/src/components/CategorySelect.tsx": ["exports"],
    "apps/web/src/components/MerchantAvatar.tsx": ["exports"],
    "apps/web/src/components/More.tsx": ["exports"],
    "apps/web/src/components/Section.tsx": ["exports"],
    "apps/web/src/components/UnknownShare.tsx": ["exports"],
    "apps/web/src/components/Why.tsx": ["types"],
    "apps/web/src/components/home/MonthPace.tsx": ["exports"],
    "apps/web/src/components/home/texts.ts": ["exports"],
    "apps/web/src/components/ops/types.ts": ["types"],
    "apps/web/src/components/optimise/MonthSteps.tsx": ["exports"],
    "apps/web/src/components/optimise/Rates.tsx": ["exports"],
    "apps/web/src/components/optimise/Tips.tsx": ["exports"],
    "apps/web/src/components/optimise/marks.tsx": ["exports"],
    "apps/web/src/components/table/DrillRows.tsx": ["exports"],
    "apps/web/src/components/table/Table.tsx": ["exports", "types"],
    "apps/web/src/components/table/Toolbar.tsx": ["types"],
    "apps/web/src/components/table/columns.ts": ["exports"],
    "apps/web/src/components/table/csv.ts": ["exports"],
    "apps/web/src/components/table/selection.tsx": ["exports"],
    "apps/web/src/components/table/types.ts": ["types"],
    "apps/web/src/components/table/view.ts": ["types"],
    "apps/web/src/components/ui/Button.tsx": ["types"],
    "apps/web/src/design/tokens.ts": ["exports", "types"],
    "apps/web/src/format.ts": ["exports"],
    "apps/web/src/pages/TransactionRows.tsx": ["exports", "types"],
    "apps/web/src/pages/reports/Month.tsx": ["exports"],
    "apps/web/src/pages/reports/More.tsx": ["exports"],
    "apps/web/src/pages/reports/parts.tsx": ["exports"],
    "apps/web/src/pages/reports/registry.ts": ["exports"],
    "apps/web/src/pages/review-items.ts": ["exports", "types"],
    "apps/web/src/pages/settings/Members.tsx": ["exports"],
    "apps/web/src/pages/settings/OffsiteBackup.tsx": ["exports"],
    "apps/web/src/pages/settings/OutsideNotices.tsx": ["exports"],
    "apps/web/src/pages/settings/account-use.ts": ["exports"],
    "apps/web/src/pages/settings/remote-access-api.ts": ["types"],
    "apps/web/src/pages/settings/use-settings-page.ts": ["exports"],
    "apps/web/src/pages/transactions/DateRange.tsx": ["exports"],
    "apps/web/src/pages/transactions/FilterChips.tsx": ["exports"],
    "apps/web/src/pages/transactions/RowMenu.tsx": ["types"],
    "apps/web/src/pages/transactions/TotalsStrip.tsx": ["types"],
    "apps/web/src/query-client.ts": ["exports"],
    "apps/web/src/routes.ts": ["exports"],
    "apps/web/src/search.ts": ["exports", "types"],
    "apps/web/src/types.ts": ["types"],
    "apps/web/src/view-opens.tsx": ["exports"],
    "apps/web/src/webauthn.ts": ["exports"]
  }
}
